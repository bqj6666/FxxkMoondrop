<?xml version="1.0" encoding="utf-8"?>
<!--
  设备通知的自定义内容布局。

  为什么不用系统 action 按钮：Android 12 起系统通知的动作按钮只渲染文字胶囊，
  传进去的图标被直接丢弃，所以「按钮带大图标」只能走自定义 RemoteViews。

  按钮形态对齐 App 主界面的档位按钮：圆形底 + 居中的大图标 + 下方文字，
  当前档位的圆底用实心高亮色（资源由 DeviceNotif 按状态 setBackgroundResource 切换）。
  这里只放内容区，系统装饰（小图标 / 应用名 / 时间）由 DecoratedCustomViewStyle 保留。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/notif_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/notif_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Line2"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:id="@+id/notif_btns"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="10dp">

        <LinearLayout
            android:id="@+id/notif_btn0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/notif_btn0_icon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:background="@drawable/notif_btn_circle"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/notif_btn0_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:layout_marginTop="3dp"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/notif_btn1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/notif_btn1_icon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:background="@drawable/notif_btn_circle"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/notif_btn1_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:layout_marginTop="3dp"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/notif_btn2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/notif_btn2_icon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:background="@drawable/notif_btn_circle"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/notif_btn2_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:layout_marginTop="3dp"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/notif_btn3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/notif_btn3_icon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:background="@drawable/notif_btn_circle"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/notif_btn3_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:layout_marginTop="3dp"
                android:maxLines="1" />
        </LinearLayout>

        <!-- 3.0.3: 第 5 槽位。ANC_V2 设备（布丁）宣告 5 档时，旧实现只有 4 个槽，
             排在末尾的档位会被静默挤掉（按 ACTION_ORDER 实际丢的是抗风）。 -->
        <LinearLayout
            android:id="@+id/notif_btn4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/notif_btn4_icon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="8dp"
                android:background="@drawable/notif_btn_circle"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/notif_btn4_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:layout_marginTop="3dp"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- alpha2.0: 官方 Material 3 主题（DayNight 深浅色自适应；NoActionBar 与各页 requestWindowFeature 一致）
     3.3.0: 补齐 M3 语义色 token，与 ThemeUtil.Palette 同源。
     3.3.1: 主题基类切换到 M3 Expressive（material 1.14.0）——按钮形状分级、
     弹簧动效、开关/对话框等组件全部走 expressive 规范；颜色仍由下方 token 覆盖。
     未显式着色的官方组件（MaterialAlertDialog 等）此前回落到 baseline 紫 #6750A4，与动态色打架。 -->
<resources>
    <style name="Theme.FxxkMoondrop" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_on_primary</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container</item>
        <item name="colorSecondaryContainer">@color/m3_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/m3_on_secondary_container</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="colorSurfaceContainer">@color/m3_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/m3_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/m3_surface_container_highest</item>
        <item name="colorSurfaceVariant">@color/m3_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorOutlineVariant">@color/m3_outline_variant</item>
        <!-- Keep framework widgets, dialogs and menus on the resolved Activity roles too. -->
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:colorBackgroundFloating">?attr/colorSurfaceContainerHigh</item>
        <item name="colorOnBackground">?attr/colorOnSurface</item>
        <item name="android:colorForeground">?attr/colorOnSurface</item>
        <item name="android:colorError">?attr/colorError</item>
        <item name="android:textColorPrimary">@color/theme_text_primary</item>
        <item name="android:textColorPrimaryDisableOnly">@color/theme_text_primary</item>
        <item name="android:textColorSecondary">@color/theme_text_secondary</item>
        <item name="android:textColorTertiary">@color/theme_text_secondary</item>
        <item name="android:textColorHint">@color/theme_text_secondary</item>
        <item name="android:textColorAlertDialogListItem">@color/theme_text_primary</item>
        <item name="android:textColorPrimaryInverse">?attr/colorOnSurfaceInverse</item>
        <item name="android:textColorSecondaryInverse">?attr/colorOnSurfaceInverse</item>
        <item name="android:textColorTertiaryInverse">?attr/colorOnSurfaceInverse</item>
        <item name="android:textColorHintInverse">?attr/colorOnSurfaceInverse</item>
        <item name="android:textColorPrimaryInverseDisableOnly">?attr/colorOnSurfaceInverse</item>
        <item name="android:textColorHighlight">@color/theme_highlight</item>
        <item name="android:textColorHighlightInverse">@color/theme_highlight_inverse</item>
        <item name="android:colorControlHighlight">@color/theme_highlight</item>
        <item name="colorControlHighlight">@color/theme_highlight</item>
        <item name="android:colorAccent">?attr/colorPrimary</item>
        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="android:colorControlActivated">?attr/colorPrimary</item>
        <item name="android:colorControlNormal">?attr/colorOnSurfaceVariant</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="colorControlNormal">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- M3 Expressive 按钮尺寸档：Medium（视觉 56dp / 左右 24dp / 图标 24dp / 16sp）。
         官方按钮的 padding、inset、图标尺寸、字级都由 SizeOverlay 决定，
         这里只换档位，不改任何手写值。 -->
    <!-- materialSizeOverlay 是**控件样式项**，不是主题属性：直接写在 ThemeOverlay 里 MaterialButton
         读不到（默认构造走 materialButtonStyle）。所以这里把档位挂进一个 widget style，
         再用主题里的 materialButtonStyle 指过去。 -->
    <style name="Widget.FxxkMoondrop.Button.Medium" parent="Widget.Material3Expressive.Button">
        <item name="materialSizeOverlay">@style/SizeOverlay.Material3Expressive.Button.Medium</item>
    </style>

    <!-- 官方 Text Button（M3 Expressive）：用于行尾的次要动作，如「恢复默认」 -->
    <style name="Widget.FxxkMoondrop.Button.Text" parent="Widget.Material3Expressive.Button.TextButton" />

    <style name="ThemeOverlay.FxxkMoondrop.ButtonText" parent="">
        <item name="materialButtonStyle">@style/Widget.FxxkMoondrop.Button.Text</item>
    </style>

    <style name="ThemeOverlay.FxxkMoondrop.ButtonMedium" parent="">
        <item name="materialButtonStyle">@style/Widget.FxxkMoondrop.Button.Medium</item>
    </style>

    <!-- 3.2.10: 统一弹窗动效（M3Ui.materialDialog 通过 window.setWindowAnimations 引用）。
         进场 fade+scale 300ms 走 emphasized decelerate，退场 200ms 走 emphasized accelerate ——
         进出场必须成对，只有进场会让关闭时硬切、显得比系统弹窗廉价。 -->
    <style name="M3DialogAnim">
        <item name="android:windowEnterAnimation">@anim/m3_dialog_in</item>
        <item name="android:windowExitAnimation">@anim/m3_dialog_out</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!--
  耳机 + 均衡器（细线条版）
  · 头梁弧线 5dp、耳罩与均衡柱之间留出呼吸位，小尺寸下不糊成一团
  · 三段柱保留旧图标语言（高度差 = 调音），全部落在 66dp 安全区内
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- 头梁：上半圆弧（细线、圆端点） -->
    <path
        android:pathData="M33,52 a21,21 0 0 1 42,0"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- 左耳罩 -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M32,50 H34 A3.5,3.5 0 0 1 37.5,53.5 V59.5 A3.5,3.5 0 0 1 34,63 H32 A3.5,3.5 0 0 1 28.5,59.5 V53.5 A3.5,3.5 0 0 1 32,50 Z" />
    <!-- 右耳罩 -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M74,50 H76 A3.5,3.5 0 0 1 79.5,53.5 V59.5 A3.5,3.5 0 0 1 76,63 H74 A3.5,3.5 0 0 1 70.5,59.5 V53.5 A3.5,3.5 0 0 1 74,50 Z" />

    <!-- 三段均衡柱：细、彼此留 3dp 间隙 -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M46,60 a2.5,2.5 0 0 1 2.5,2.5 v5 a2.5,2.5 0 0 1 -5,0 v-5 a2.5,2.5 0 0 1 2.5,-2.5 Z" />
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M54,54 a2.5,2.5 0 0 1 2.5,2.5 v11 a2.5,2.5 0 0 1 -5,0 v-11 a2.5,2.5 0 0 1 2.5,-2.5 Z" />
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M62,57 a2.5,2.5 0 0 1 2.5,2.5 v8 a2.5,2.5 0 0 1 -5,0 v-8 a2.5,2.5 0 0 1 2.5,-2.5 Z" />
</vector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 莫奈动态色（深色）；资源名与 ThemeUtil.dyn() 完全一致。
     neutral 调色板不分深浅（框架只给一套 index），深色靠**取高 index** 得到暗色：
       页面底 neutral1_900(tone10) / 卡片 neutral1_800(tone20)（卡片更亮）
       正文 neutral1_100(tone90)、次级文字 neutral1_200(tone80)
       outline neutral1_400(tone60)、outlineVariant neutral1_700(tone30) -->
<resources>
    <color name="m3_primary">@android:color/system_accent1_400</color>
    <color name="m3_on_primary">@android:color/system_accent1_900</color>
    <color name="m3_primary_container">@android:color/system_accent1_800</color>
    <color name="m3_on_primary_container">@android:color/system_accent1_50</color>
    <color name="m3_secondary_container">@android:color/system_accent1_800</color>
    <color name="m3_on_secondary_container">@android:color/system_accent1_50</color>
    <color name="m3_surface">@android:color/system_neutral1_900</color>
    <color name="m3_surface_container">@android:color/system_neutral1_800</color>
    <color name="m3_surface_container_high">@android:color/system_neutral1_700</color>
    <color name="m3_surface_container_highest">@android:color/system_neutral1_700</color>
    <color name="m3_surface_variant">@android:color/system_neutral1_700</color>
    <color name="m3_on_surface">@android:color/system_neutral1_100</color>
    <color name="m3_on_surface_variant">@android:color/system_neutral1_200</color>
    <color name="m3_outline">@android:color/system_neutral1_400</color>
    <color name="m3_outline_variant">@android:color/system_neutral1_700</color>
</resources>

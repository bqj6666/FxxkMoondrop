<?xml version="1.0" encoding="utf-8"?>
<!-- FxxkMoondrop M3 构建链文本 manifest（由二进制 AXML 完整转写，组件/权限/元数据不增不减） -->
<!-- 版本号以 app/build.gradle.kts 的 defaultConfig 为准（AGP 合并时覆盖此处）；
     这两个属性此前停留在旧链的 alpha2.27 / 254，3.0.4 起同步为正式版本号，避免仓库里残留 alpha 字样。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.fxxkmoondrop.secret"
    android:versionCode="328"
    android:versionName="3.2.8">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 不声明 FOREGROUND_SERVICE / FOREGROUND_SERVICE_CONNECTED_DEVICE：
         HeadsetDetectService 从不调用 startForeground()，实为普通后台服务
         （靠 START_STICKY + AlarmManager 保活），该权限无任何作用。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 3.0.5: 无 Root 保活 —— 用系统弹窗申请电池优化白名单（旧实现只能用 root 的 deviceidle 命令） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 不再声明 SYSTEM_ALERT_WINDOW：本模块从不创建悬浮窗，
         弹窗走的是 GMS 进程内的既有窗口（受 GMS 自身权限约束），与本应用无关。 -->

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <application
        android:label="Fxxkmoondrop"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.FxxkMoondrop"
        android:allowBackup="false">

        <activity android:name=".PermissionActivity" android:exported="false" />


        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".PopupActivity" android:exported="false" />

        <!-- 3.1.0: 首次启动的使用引导（设置页最底部也能重看） -->
        <activity android:name=".OnboardingActivity" android:exported="false" />

        <!-- alpha2.26.5: 跨进程配置读取（GMS FastPair 弹窗进程查模块设置） -->
        <provider
            android:name=".PrefsProvider"
            android:authorities="com.fxxkmoondrop.secret.prefs"
            android:exported="true" />

        <service
            android:name=".HeadsetDetectService"
            android:exported="false" />

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="com.fxxkmoondrop.secret.BT_EVENT" />
            </intent-filter>
        </receiver>

        <receiver android:name=".AliveReceiver" android:exported="false" />

        <!-- 第 5 项：通知栏 ANC 档位按钮 -->
        <receiver android:name=".NotifActionReceiver" android:exported="false" />
    </application>
</manifest>

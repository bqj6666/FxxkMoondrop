# FxxkMoondrop Gradle 配置
org.gradle.jvmargs=-Xmx4g -XX:MaxMetaspaceSize=1g -Dfile.encoding=UTF-8
org.gradle.parallel=true
org.gradle.caching=true

# AndroidX
android.useAndroidX=true

# ARM64 Linux 上官方 aapt2 为 x86_64：经 qemu-x86_64 包装执行。
# 版本须与 AGP 匹配。本项目现为 AGP 9.4.1 -> aapt2 9.4.1-15978811（2.20-15978811），
# 包装脚本见 /workspace/tools/aapt2-941/aapt2（真实二进制在 bin/）。
#
# ⚠️ 3.2.13 踩过的坑：AGP 从 8.6.1 升到 9.4.1 后，这里若仍指向 aapt2-861
# （8.6.1 专用），资源打包会**静默失败** —— assembleRelease 每一步都报成功，
# 产物却缺 AndroidManifest.xml 与整个 res/。构建成功、dex 正常、签名正常，
# 只有一个装不上的 APK。CI 早就用 sed 删掉这一行改用原生 aapt2，不受影响。
# 升级 AGP 时**必须同步更新这一行**。
android.aapt2FromMavenOverride=/workspace/tools/aapt2-941/aapt2

# 构建产物输出目录统一，便于与旧链 build2/ 并行管理
android.overridePathCheck=true

# 源码直接引用库资源（abc_ic_ab_back_material 等），恢复传统合并 R（与旧链 gen_lib_rtxt 行为一致）
android.nonTransitiveRClass=false
